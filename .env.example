# Frontend only. Set this in .env.local for Vite; never put provider secrets here.
VITE_CONVEX_URL=https://<deployment>.convex.cloud
VITE_VANTA_CONVEX_URL=https://<vanta-production-deployment>.convex.cloud

# Optional server-side Vanta portfolio integration. Never expose this key to Vite/browser code.
VANTA_API_BASE_URL=https://<vanta-production-deployment>.convex.site
VANTA_API_KEY=<vanta-api-key-with-read-scope>

# Gemini: used by grounded benchmark research and preliminary document screening.
GEMINI_API_KEY=<google-ai-studio-key>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BENCHMARK_MODEL=gemini-3.1-pro-preview

# Resend: used for screening notification emails (separate sender config from auth).
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Omni <alerts@your-verified-domain.example>
DIT_NOTIFICATION_EMAIL=<dit-notification-email>
DIT_ALERT_THRESHOLD_SCORE=66

# Configure these server-side on your Omni Convex deployment.
VANTA_CONVEX_SITE_URL=https://<vanta-production-deployment>.convex.site
FIRECRAWL_API_KEY=fc-<firecrawl-api-key>
REVA_ADMIN_EMAIL=<reva-admin-email>
